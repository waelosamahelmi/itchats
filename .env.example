# ItChats AI — Environment Variables
# Copy this file to .env and fill in your values

# Alibaba Cloud (DashScope) API Key
# Get yours at: https://dashscope.console.aliyun.com/apiKey
REACT_APP_ALIBABA_API_KEY=sk-your-api-key-here

# Mapbox API Key (for Snap Map)
# Get yours at: https://account.mapbox.com/access-tokens
REACT_APP_MAP_BOX_API_KEY=pk-your-mapbox-key-here

# App URL (used for OAuth redirects, etc.)
REACT_APP_URL=https://localhost:3000
